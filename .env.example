# ---------------------------------------------------------------------------
# Performity P&L — environment
#
# The prototype needs NONE of these: it builds and runs with zero config.
# Add them as you connect each real source. The in-app Guide & setup section
# (/guide) explains what each one unlocks.
#
# Copy to .env.local for local development, and add the same keys in
# Vercel → Project → Settings → Environment Variables.
# ---------------------------------------------------------------------------

# --- Database --------------------------------------------------------------
# Pooled connection used by the app.
DATABASE_URL=
# Direct (non-pooled) connection, required for migrations.
DIRECT_URL=

# --- Auth ------------------------------------------------------------------
# openssl rand -base64 32
AUTH_SECRET=
AUTH_URL=http://localhost:3000
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# --- Shopify ---------------------------------------------------------------
SHOPIFY_STORE_DOMAIN=
SHOPIFY_ADMIN_TOKEN=
SHOPIFY_WEBHOOK_SECRET=

# --- Amazon Seller Central (SP-API) ----------------------------------------
AMAZON_SP_CLIENT_ID=
AMAZON_SP_CLIENT_SECRET=
AMAZON_SP_REFRESH_TOKEN=

# --- Ad platforms ----------------------------------------------------------
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=
GOOGLE_ADS_DEVELOPER_TOKEN=

# --- Cost sheet import -----------------------------------------------------
# Base64-encoded service-account JSON with read access to the sheet.
GOOGLE_SHEETS_SERVICE_ACCOUNT=

# --- Scheduled jobs --------------------------------------------------------
# openssl rand -hex 24 — protects /api/cron/nightly
CRON_SECRET=

# --- Notifications ---------------------------------------------------------
RESEND_API_KEY=
SLACK_WEBHOOK_URL=
